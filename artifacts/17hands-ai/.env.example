# Bio page intake form (/bio-pages/start). Copy to .env for local work; never commit .env.
# In Vercel these go under Project > Settings > Environment Variables. See README.md.
# With every value left blank, `pnpm dev` still runs the form against in-memory stand-ins.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
# The secret/service_role key. Server only: it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket created by the migration.
SUPABASE_INTAKE_BUCKET=bio-intake

# --- Cloudflare Turnstile (dash.cloudflare.com > Turnstile > your widget) ---
# Site key is public and is built into the page. The VITE_ prefix is required.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Resend (resend.com > API Keys) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. 17hands intake <intake@17hands.ai>
INTAKE_EMAIL_FROM=
# Where the "new submission" notice goes.
INTAKE_NOTIFY_EMAIL=
# Link placed in the notice. {id} is replaced with the submission id. See README.md.
INTAKE_SUBMISSION_URL_TEMPLATE=

# --- Intake API ---
# Signs upload tokens and hashes IP addresses for rate limiting. 32+ random characters:
#   openssl rand -base64 48
INTAKE_SIGNING_SECRET=
# Comma-separated origins allowed to post the form. Vercel preview URLs are allowed automatically.
INTAKE_ALLOWED_ORIGINS=https://17hands.ai
